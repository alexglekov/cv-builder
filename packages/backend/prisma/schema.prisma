generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ROLES {
  ADMIN
  MANAGER
  USER
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String
  surname    String
  profileUri String?
  role       ROLES     @default(value: USER)
  Auth       Auth?
  Profiles   Profiles?
}

model Vacancies {
  id String           @id @default(uuid())
  vacancyId String?
  name String?
  salaryFrom Int?
  salaryTo Int?
  currency String?
  typeId String?
  typeName String?
  addressCity String?
  addressStreet String?
  addressRaw String?
  publishedAt String?
  createdAt String?
  archived Boolean?
  vacancyUrl String?
  employerName String?
  employerId String?
  employerUrl String?
  employerLogoUrl String?
  requirements String?
  responsibilities String?
  scheduleId String?
  scheduleName String?
  professionalRoleId String?
  professionalRoleName String?
  experienceId String?
  experienceName String?
  employmentId String?
  employmentName String?
  passLevel String?
  profileId Int
  passMessage String?
  description String
  keySkills Json          @db.JsonB    // массив строк
  profile   Profiles @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  advice String?
}

model Auth {
  id                   Int            @id @default(autoincrement())
  refreshToken         String?
  signUpProvider       SignUpProvider
  providerRefreshToken String?
  password             String?
  userId               Int?           @unique
  user                 User?          @relation(fields: [userId], references: [id])
}

model Languages {
  id        Int      @id @default(autoincrement())
  rank      LANGRANK
  profileId Int
  languageId Int
  Langnames  Langnames @relation(fields: [languageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Profiles  Profiles @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Profiles {
  id        Int         @id
  specialty String?     @default("default") @db.VarChar
  education String?     @default("default") @db.VarChar
  domains   String[]    @db.VarChar
  Languages Languages[]
  biography String?     @default("default")
  User      User        @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Projects  Projects[]
  Cv        Cv[]
  Vacancies Vacancies[]
}

model Projects {
  id                   Int                    @id @default(autoincrement())
  title                String                 @db.VarChar
  description          String
  position             String                 @db.VarChar
  start                DateTime               @db.Date
  end                  DateTime               @db.Date
  respAndAchs          String[]
  userId               Int
  actual               Boolean                @default(true)
  Profiles             Profiles               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ProjectsTechnologies ProjectsTechnologies[]
}

model Cv {
  key         String @id
  domains     String[]
  title       String @db.VarChar
  description String
  userId      Int
  created     DateTime              
  updated     DateTime 
  Profiles    Profiles   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ProjectsTechnologies {
  projectId    Int
  technologyId Int          @db.SmallInt
  Projects     Projects     @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Technologies Technologies @relation(fields: [technologyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([projectId, technologyId])
}

model Technologies {
  id                   Int                    @id @default(autoincrement()) @db.SmallInt
  name                 String                 @db.VarChar
  type             String                     @db.VarChar
  Techtype             Techtypes?             @relation(fields: [type], references: [name], onDelete: Cascade, onUpdate: Cascade)
  ProjectsTechnologies ProjectsTechnologies[]            
}

model Techtypes {
  id                   Int                    @id @default(autoincrement()) @db.SmallInt
  name                 String                 @db.VarChar @unique
  Technologies         Technologies[]
}

enum SignUpProvider {
  GOOGLE
  LOCAL
}

model Langnames {
  id                   Int                    @id @default(autoincrement()) @db.SmallInt
  name                 String                 @db.VarChar
  Languages Languages[]
}


enum LANGRANK {
  A1
  A2
  B1
  B2
  C1
  C2
}
