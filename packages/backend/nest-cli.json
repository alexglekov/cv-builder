{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "projects": {
    "exceptions": {
      "type": "library",
      "root": "libs/exceptions",
      "entryFile": "index",
      "sourceRoot": "libs/exceptions/src",
      "compilerOptions": {
        "tsConfigPath": "libs/exceptions/tsconfig.lib.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "aws": {
      "type": "library",
      "root": "libs/aws",
      "entryFile": "index",
      "sourceRoot": "libs/aws/src",
      "compilerOptions": {
        "tsConfigPath": "libs/aws/tsconfig.lib.json"
      }
    },
    "pdf": {
      "type": "library",
      "root": "libs/pdf",
      "entryFile": "index",
      "sourceRoot": "libs/pdf/src",
      "compilerOptions": {
        "tsConfigPath": "libs/pdf/tsconfig.lib.json"
      }
    },
    "pdf-creator": {
      "type": "library",
      "root": "libs/pdf-creator",
      "entryFile": "index",
      "sourceRoot": "libs/pdf-creator/src",
      "compilerOptions": {
        "tsConfigPath": "libs/pdf-creator/tsconfig.lib.json"
      }
    }
  },
  "compilerOptions": {
    "assets": ["../../../node_modules/pdfkit/js/data"],
    "webpack": true
  }
}